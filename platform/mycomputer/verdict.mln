import debug from "@kernel/debug/debug.mln";
import { halt_cpu } from "@kernel/arch/halt.masm";

void __mlt_platform_pass(char* name) {
    debug.print("TEST_PASS:");
    debug.println(name);
    halt_cpu();
}

void __mlt_platform_fail(char* reason) {
    debug.print("TEST_FAIL:");
    debug.println(reason);
    halt_cpu();
}
