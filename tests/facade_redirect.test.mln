import assert from "../../MyStdLib/assert.mln";
import mock from "../runtime/facade.mln";

i32 read_word(i32 block, i32 buffer) {
    return block + buffer;
}

i32 read_via_service(i32 block, i32 buffer) {
    return read_word(block, buffer);
}

i32 static_word(i32 value) {
    return value + 1;
}

i32 copy_word(i32 value, i32 out) {
    i32* destination = (i32*)out;
    *destination = value;
    return value;
}

i32 g_fake_calls = 0;

i32 fake_copy_word(i32 value, i32 out) {
    i32* destination = (i32*)out;
    g_fake_calls = g_fake_calls + 1;
    *destination = value + 7;
    return 55;
}

i32 sum_four(i32 a, i32 b, i32 c, i32 d) {
    return a + b + c + d;
}

i32 g_original_delegations = 0;

i32 spy_sum_four(i32 a, i32 b, i32 c, i32 d) {
    g_original_delegations = g_original_delegations + 1;
    return mock.call_original(a, b, c, d) + 100;
}

i32 g_notifications = 0;

void notify_four(i32 a, i32 b, i32 c, i32 d) {
    g_notifications = g_notifications + a + b + c + d;
}

void spy_notify_four(i32 a, i32 b, i32 c, i32 d) {
    mock.call_original(a, b, c, d);
}

struct Pair {
    i32 left;
    i32 right;
};

Pair make_pair(i32 left, i32 right) {
    Pair result;
    result.left = left;
    result.right = right;
    return result;
}

Pair pair_via_service(i32 left, i32 right) {
    return make_pair(left, right);
}

i32 g_fake_pair_calls = 0;

Pair fake_pair(i32 left, i32 right) {
    Pair result;
    g_fake_pair_calls = g_fake_pair_calls + 1;
    result.left = left + 10;
    result.right = right + 20;
    return result;
}

/*@Test "spy_redirect" { step: 100000; }*/
void spy_redirect() {
    mock.spy(read_word)
        .when(2, mock.any())
        .ret(-1);

    assert.assert_true(read_via_service(2, 99) == -1, "mocked nested target return");
    assert.assert_true(read_via_service(3, 4) == 7, "spy falls back to original target");
    assert.assert_true(mock.calls(read_word) == 2, "spy records every call");
    assert.assert_true(mock.called_with(read_word, 2, mock.any()), "spy records mocked arguments");
    assert.assert_true(mock.called_with(read_word, 3, 4), "spy records original arguments");
}

/*@Test "mock_sequences"*/
void mock_sequences() {
    mock.of(static_word)
        .when(5)
        .ret(77)
        .then_ret(88);
    assert.assert_true(static_word(5) == 77, "mock returns first configured value");
    assert.assert_true(static_word(5) == 88, "mock returns chained value");
    assert.assert_true(mock.calls(static_word) == 2, "mock records every call");
    assert.assert_true(mock.called_with(static_word, 5), "mock records configured argument");
}

/*@Test "callback_redirect"*/
void callback_redirect() {
    mock.of(copy_word)
        .when(3, mock.any())
        .call(fake_copy_word);

    i32 output = 0;
    assert.assert_true(copy_word(3, (i32)&output) == 55, "fake return is forwarded");
    assert.assert_true(output == 10, "fake writes through the output pointer");
    assert.assert_true(g_fake_calls == 1, "fake is called once");
    assert.assert_true(mock.calls(copy_word) == 1, "callback call is recorded");
    assert.assert_true(mock.called_with(copy_word, 3, mock.any()), "callback arguments are recorded");
}

/*@Test "spy callback delegates to original"*/
void spy_callback_delegates_to_original() {
    mock.spy(sum_four)
        .when(1, 2, 3, 4)
        .call(spy_sum_four);

    assert.assert_true(sum_four(1, 2, 3, 4) == 110, "fake delegates then adjusts result");
    assert.assert_true(g_original_delegations == 1, "fake delegates exactly once");
    assert.assert_true(mock.calls(sum_four) == 1, "four-word call is recorded");
    assert.assert_true(mock.called_with(sum_four, 1, 2, 3, 4), "four-word match succeeds");
}

/*@Test "void spy callback delegates to original"*/
void void_spy_callback_delegates_to_original() {
    mock.spy(notify_four)
        .when(4, 3, 2, 1)
        .call(spy_notify_four);

    notify_four(4, 3, 2, 1);
    assert.assert_true(g_notifications == 10, "void target reaches original implementation");
    assert.assert_true(mock.called_with(notify_four, 4, 3, 2, 1), "void call records four words");
}

/*@Test "aggregate mock callback forwards hidden result buffer"*/
void aggregate_mock_callback_forwards_hidden_result_buffer() {
    mock.of(make_pair)
        .when(2, 3)
        .call(fake_pair);

    Pair result = pair_via_service(2, 3);
    assert.assert_true(result.left == 12, "aggregate fake writes left field through hidden buffer");
    assert.assert_true(result.right == 23, "aggregate fake writes right field through hidden buffer");
    assert.assert_true(g_fake_pair_calls == 1, "aggregate fake runs once");
    assert.assert_true(mock.calls(make_pair) == 1, "aggregate mock records the call");
    assert.assert_true(mock.called_with(make_pair, 2, 3), "aggregate mock records arguments");
}

/*@Test "aggregate spy falls back to original"*/
void aggregate_spy_falls_back_to_original() {
    mock.spy(make_pair)
        .when(9, 9)
        .call(fake_pair);

    Pair original = pair_via_service(4, 5);
    Pair fake = pair_via_service(9, 9);
    assert.assert_true(original.left == 4 && original.right == 5, "aggregate spy forwards unmatched call");
    assert.assert_true(fake.left == 19 && fake.right == 29, "aggregate spy forwards matched call to fake");
    assert.assert_true(mock.calls(make_pair) == 2, "aggregate spy records both calls");
}
