import assert from "../../MyStdLib/assert.mln";
import mock from "../runtime/facade.mln";

i32 read_word(i32 block, i32 buffer) {
    return block + buffer;
}

i32 read_via_service(i32 block, i32 buffer) {
    return read_word(block, buffer);
}

i32 static_word(i32 value) {
    return value + 1;
}

test("facade_redirect", {
    step: 100000;
}, () => {
    mock.spy(read_word)
        .when(2, mock.any())
        .ret(-1);

    assert.assert_true(read_via_service(2, 99) == -1, "mocked nested target return");
    assert.assert_true(read_via_service(3, 4) == 7, "spy falls back to original target");

    mock.of(static_word)
        .when(5)
        .ret(77)
        .then_ret(88);
    assert.assert_true(static_word(5) == 77, "mock returns first configured value");
    assert.assert_true(static_word(5) == 88, "mock returns chained value");
});
