package mock;

// Public, target-agnostic facade used by test sources. MyLangTester emits one
// entry point per `of(target)` / `spy(target)` target and redirects direct
// calls to it at link time. This v1 facade intentionally accepts word-sized
// scalar or pointer arguments and returns a word.
export struct TargetMock {
    i32 slot;
};

export struct TargetRule {
    i32 slot;
    i32 rule;
};

// This global is exported because generated entry objects access it. Keeping
// the target identity rather than a runner-assigned slot means configuration
// order never changes dispatch behaviour.
export i32 mock_active_target = 0;
export i32 mock_result = 0;
// A configured fake is invoked by the generated target entry.  The callback
// uses the target's ordinary ABI (up to three word-sized arguments in r5-r7)
// and returns its result in r1.
export i32 mock_callback = 0;

i32 mock_targets[8];
i32 mock_modes[8];
i32 mock_rule_counts[8];
i32 mock_rule_arg_counts[64];
i32 mock_rule_args[192];
i32 mock_rule_return_counts[64];
i32 mock_rule_returns[512];
i32 mock_rule_cursors[64];
i32 mock_rule_callbacks[64];
// Calls are recorded by the generated target entries. Keep the most recent
// sixteen argument triples per target, while preserving the full call count.
i32 mock_call_counts[8];
i32 mock_call_args[384];
TargetMock mock_handles[8];
TargetRule mock_rule_handles[64];

// A matcher is represented directly in the generated target facade: this
// sentinel means "any", every other i32 is an equality matcher.
export i32 any() { return -2147483647; }

i32 rule_index(i32 slot, i32 rule) { return slot * 8 + rule; }
i32 rule_arg_index(i32 slot, i32 rule, i32 arg) { return rule_index(slot, rule) * 3 + arg; }
i32 rule_return_index(i32 slot, i32 rule, i32 value) { return rule_index(slot, rule) * 8 + value; }
i32 call_arg_index(i32 slot, i32 call, i32 arg) { return (slot * 16 + call) * 3 + arg; }

i32 find_slot(i32 target) {
    i32 index = 0;
    while (index < 8) {
        if (mock_targets[index] == target) return index;
        index = index + 1;
    }
    return -1;
}

// `of` is a grammar keyword, so the parser lowers the public spelling
// `mock.of(target)` to this exported implementation symbol.
export TargetMock* target(i32 target) {
    i32 slot = find_slot(target);
    if (slot < 0) {
        slot = 0;
        while (slot < 8 && mock_targets[slot] != 0) slot = slot + 1;
        if (slot >= 8) return (TargetMock*)0;
        mock_targets[slot] = target;
        mock_modes[slot] = 1;
        mock_rule_counts[slot] = 0;
        mock_handles[slot].slot = slot;
    }
    mock_modes[slot] = 1;
    return &mock_handles[slot];
}

export TargetMock* spy(i32 fn) {
    TargetMock* handle = target(fn);
    if (handle != (TargetMock*)0) mock_modes[handle->slot] = 2;
    return handle;
}

// Called by the generated entry before dispatch. r5-r7 are copied into the
// entry frame first, so recording may freely use normal call-clobbered ABI
// registers. `calls` is exact; `called_with` searches the latest sixteen.
export void record(i32 a, i32 b, i32 c) {
    i32 slot = find_slot(mock_active_target);
    if (slot < 0) return;
    i32 call = mock_call_counts[slot] & 15;
    mock_call_args[call_arg_index(slot, call, 0)] = a;
    mock_call_args[call_arg_index(slot, call, 1)] = b;
    mock_call_args[call_arg_index(slot, call, 2)] = c;
    mock_call_counts[slot] = mock_call_counts[slot] + 1;
}

export i32 calls(i32 target) {
    i32 slot = find_slot(target);
    if (slot < 0) return 0;
    return mock_call_counts[slot];
}

// Match the supplied prefix of a recorded call. This lets callers verify
// functions with zero through three word arguments without declaring Args.
export i32 called_with(i32 target, rest args) {
    if (args.len > 3) return 0;
    i32 slot = find_slot(target);
    if (slot < 0) return 0;
    i32 count = mock_call_counts[slot];
    if (count > 16) count = 16;
    i32 call = 0;
    while (call < count) {
        i32 matched = 1;
        if (args.len > 0) {
            i32 expected = args[0];
            i32 actual = mock_call_args[call_arg_index(slot, call, 0)];
            if (expected != any() && expected != actual) matched = 0;
        }
        if (args.len > 1) {
            i32 expected = args[1];
            i32 actual = mock_call_args[call_arg_index(slot, call, 1)];
            if (expected != any() && expected != actual) matched = 0;
        }
        if (args.len > 2) {
            i32 expected = args[2];
            i32 actual = mock_call_args[call_arg_index(slot, call, 2)];
            if (expected != any() && expected != actual) matched = 0;
        }
        if (matched != 0) return 1;
        call = call + 1;
    }
    return 0;
}

TargetRule* (TargetMock* self) when(rest args) {
    i32 slot = self->slot;
    i32 rule = mock_rule_counts[slot];
    if (rule >= 8 || args.len > 3) return (TargetRule*)0;
    i32 key = rule_index(slot, rule);
    mock_rule_arg_counts[key] = args.len;
    i32 index = 0;
    while (index < args.len) {
        mock_rule_args[rule_arg_index(slot, rule, index)] = args[index];
        index = index + 1;
    }
    mock_rule_return_counts[key] = 0;
    mock_rule_cursors[key] = 0;
    mock_rule_callbacks[key] = 0;
    mock_rule_counts[slot] = rule + 1;
    mock_rule_handles[key].slot = slot;
    mock_rule_handles[key].rule = rule;
    return &mock_rule_handles[key];
}

TargetRule* (TargetRule* self) ret(i32 value) {
    i32 key = rule_index(self->slot, self->rule);
    // A rule has one action.  A later `.ret(...)` deliberately replaces a
    // previously configured fake while still allowing chained return values.
    mock_rule_callbacks[key] = 0;
    i32 count = mock_rule_return_counts[key];
    if (count >= 8) return (TargetRule*)0;
    mock_rule_returns[rule_return_index(self->slot, self->rule, count)] = value;
    mock_rule_return_counts[key] = count + 1;
    return self;
}

TargetRule* (TargetRule* self) then_ret(i32 value) {
    return self.ret(value);
}

// Invoke `fn` for a matching call instead of returning a stored word.  This
// makes pointer/out-parameter effects testable without making production code
// depend on DI.  `fn` must have the same word-sized ABI as the target.
TargetRule* (TargetRule* self) call(i32 fn) {
    i32 key = rule_index(self->slot, self->rule);
    mock_rule_return_counts[key] = 0;
    mock_rule_cursors[key] = 0;
    mock_rule_callbacks[key] = fn;
    return self;
}

// Called by an entry after it stores its target address in
// `mock_active_target`. The first three machine ABI arguments are already in
// r5-r7 and become a/b/c here. A nonzero return means either
// `mock_result` or `mock_callback` is valid; the latter takes precedence.
export i32 dispatch(i32 a, i32 b, i32 c) {
    mock_callback = 0;
    i32 slot = find_slot(mock_active_target);
    if (slot < 0 || mock_modes[slot] == 0) return 0;
    i32 rule = mock_rule_counts[slot];
    while (rule != 0) {
        rule = rule - 1;
        i32 key = rule_index(slot, rule);
        i32 count = mock_rule_arg_counts[key];
        i32 matched = 1;
        if (count > 0) {
            i32 expected = mock_rule_args[rule_arg_index(slot, rule, 0)];
            if (expected != any() && expected != a) matched = 0;
        }
        if (count > 1) {
            i32 expected = mock_rule_args[rule_arg_index(slot, rule, 1)];
            if (expected != any() && expected != b) matched = 0;
        }
        if (count > 2) {
            i32 expected = mock_rule_args[rule_arg_index(slot, rule, 2)];
            if (expected != any() && expected != c) matched = 0;
        }
        if (matched != 0 && mock_rule_callbacks[key] != 0) {
            mock_callback = mock_rule_callbacks[key];
            return 1;
        }
        if (matched != 0 && mock_rule_return_counts[key] != 0) {
            i32 cursor = mock_rule_cursors[key];
            i32 returns = mock_rule_return_counts[key];
            if (cursor >= returns) cursor = returns - 1;
            mock_result = mock_rule_returns[rule_return_index(slot, rule, cursor)];
            if (mock_rule_cursors[key] < returns - 1) {
                mock_rule_cursors[key] = mock_rule_cursors[key] + 1;
            }
            return 1;
        }
    }
    return 0;
}

// The generated entry invokes the original implementation only for an
// unmatched Spy call. Mock mismatch is an assertion failure.
export i32 should_call_original() {
    i32 slot = find_slot(mock_active_target);
    if (slot < 0) return 0;
    return mock_modes[slot] == 2;
}

extern void assert_fail(char* reason);
export void unexpected() { assert_fail("mock.unexpected"); }
