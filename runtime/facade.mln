package mock;

// Public, target-agnostic facade used by test sources. MyLangTester emits one
// entry point per `of(target)` / `spy(target)` target and redirects direct
// calls to it at link time. This v1 facade intentionally accepts word-sized
// scalar or pointer arguments and stores a word for `.ret(...)`.  Fake
// callbacks use the target's full ABI, including the compiler's hidden r4
// result-buffer pointer for struct/array returns. The generated entry carries
// up to six ordinary ABI words (three registers and three stack arguments).
export struct TargetMock {
    i32 slot;
};

export struct TargetRule {
    i32 slot;
    i32 rule;
};

// Configuration is shared by a test, but call activation is task-local.
// A test that starts a scheduler supplies `set_context_provider` with a
// function returning the current task identity. Without one, context zero
// preserves the single-threaded behaviour of earlier TestKit releases.
i32 mock_context_provider = 0;
i32 mock_context_ids[8];
i32 mock_context_used[8];
i32 mock_active_targets[64];
i32 mock_active_depths[8];
i32 mock_context_results[64];
i32 mock_context_callbacks[64];

i32 mock_targets[8];
i32 mock_modes[8];
i32 mock_rule_counts[8];
i32 mock_rule_arg_counts[64];
i32 mock_rule_args[384];
i32 mock_rule_return_counts[64];
i32 mock_rule_returns[512];
i32 mock_rule_cursors[512];
i32 mock_rule_callbacks[64];
i32 mock_matchers[8];
i32 mock_matcher_count = 0;
// Calls are recorded per active context. Keep the most recent sixteen
// argument sextuples per target, while preserving the exact total per context.
i32 mock_call_counts[64];
i32 mock_call_args[6144];
TargetMock mock_handles[8];
TargetRule mock_rule_handles[64];

// A matcher is represented directly in the generated target facade: this
// sentinel means "any", every other i32 is an equality matcher.
export i32 any() { return -2147483647; }

// Register an allocation-free predicate matcher. The predicate receives the
// intercepted ABI word and returns nonzero to match. For a struct argument,
// that word is its by-value buffer address, so a test can inspect fields
// without declaring an Args wrapper.
export i32 match(i32 predicate) {
    if (mock_matcher_count >= 8) {
        assert_fail("mock.matcher_capacity");
        return 0;
    }
    i32 slot = mock_matcher_count;
    mock_matchers[slot] = predicate;
    mock_matcher_count = slot + 1;
    return -2147483600 - slot;
}

i32 matcher_matches(i32 expected, i32 actual) {
    if (expected == any()) return 1;
    i32 slot = -2147483600 - expected;
    if (slot >= 0 && slot < mock_matcher_count) {
        i32 predicate = mock_matchers[slot];
        return predicate(actual);
    }
    return expected == actual;
}

i32 rule_index(i32 slot, i32 rule) { return slot * 8 + rule; }
i32 rule_arg_index(i32 slot, i32 rule, i32 arg) { return rule_index(slot, rule) * 6 + arg; }
i32 rule_return_index(i32 slot, i32 rule, i32 value) { return rule_index(slot, rule) * 8 + value; }
i32 context_target_index(i32 context, i32 target) { return context * 8 + target; }
i32 context_rule_index(i32 context, i32 slot, i32 rule) { return context * 64 + rule_index(slot, rule); }
i32 context_call_arg_index(i32 context, i32 slot, i32 call, i32 arg) {
    return ((context * 8 + slot) * 16 + call) * 6 + arg;
}
i32 context_active_index(i32 context, i32 depth) { return context * 8 + depth; }

i32 find_slot(i32 target) {
    i32 index = 0;
    while (index < 8) {
        if (mock_targets[index] == target) return index;
        index = index + 1;
    }
    return -1;
}

extern void assert_fail(char* reason);

// Install a task identity provider before scheduling begins. The provider is
// a plain function pointer so TestKit stays independent from any one kernel.
export void set_context_provider(i32 provider) { mock_context_provider = provider; }

i32 current_context_id() {
    if (mock_context_provider == 0) return 0;
    return mock_context_provider();
}

i32 context_slot(i32 create) {
    i32 id = current_context_id();
    i32 slot = 0;
    while (slot < 8) {
        if (mock_context_used[slot] != 0 && mock_context_ids[slot] == id) return slot;
        slot = slot + 1;
    }
    if (create == 0) return -1;
    slot = 0;
    while (slot < 8 && mock_context_used[slot] != 0) slot = slot + 1;
    if (slot >= 8) {
        assert_fail("mock.context_capacity");
        return -1;
    }
    mock_context_used[slot] = 1;
    mock_context_ids[slot] = id;
    mock_active_depths[slot] = 0;
    mock_context_results[context_active_index(slot, 0)] = 0;
    mock_context_callbacks[context_active_index(slot, 0)] = 0;
    return slot;
}

export i32 current_target() {
    i32 context = context_slot(0);
    if (context < 0 || mock_active_depths[context] <= 0) return 0;
    return mock_active_targets[context_active_index(context, mock_active_depths[context] - 1)];
}

export i32 current_result() {
    i32 context = context_slot(0);
    if (context < 0 || mock_active_depths[context] <= 0) return 0;
    return mock_context_results[context_active_index(context, mock_active_depths[context] - 1)];
}

export i32 current_callback() {
    i32 context = context_slot(0);
    if (context < 0 || mock_active_depths[context] <= 0) return 0;
    return mock_context_callbacks[context_active_index(context, mock_active_depths[context] - 1)];
}

export void enter(i32 target) {
    i32 context = context_slot(1);
    if (context < 0) return;
    i32 depth = mock_active_depths[context];
    if (depth >= 8) {
        assert_fail("mock.nesting_capacity");
        return;
    }
    mock_active_targets[context_active_index(context, depth)] = target;
    mock_active_depths[context] = depth + 1;
}

export void leave() {
    i32 context = context_slot(0);
    if (context < 0 || mock_active_depths[context] <= 0) {
        assert_fail("mock.invalid_leave");
        return;
    }
    mock_active_depths[context] = mock_active_depths[context] - 1;
}

// `of` is a grammar keyword, so the parser lowers the public spelling
// `mock.of(target)` to this exported implementation symbol.
export TargetMock* target(i32 target) {
    i32 slot = find_slot(target);
    if (slot < 0) {
        slot = 0;
        while (slot < 8 && mock_targets[slot] != 0) slot = slot + 1;
        if (slot >= 8) {
            assert_fail("mock.target_capacity");
            return (TargetMock*)0;
        }
        mock_targets[slot] = target;
        mock_modes[slot] = 1;
        mock_rule_counts[slot] = 0;
        mock_handles[slot].slot = slot;
    }
    mock_modes[slot] = 1;
    return &mock_handles[slot];
}

export TargetMock* spy(i32 fn) {
    TargetMock* handle = target(fn);
    if (handle != (TargetMock*)0) mock_modes[handle->slot] = 2;
    return handle;
}

// Called by the generated entry before dispatch. r5-r7 are copied into the
// entry frame first, so recording may freely use normal call-clobbered ABI
// registers. `calls` is exact; `called_with` searches the latest sixteen.
export void record(i32 a, i32 b, i32 c, i32 d, i32 e, i32 f) {
    i32 context = context_slot(1);
    if (context < 0) return;
    i32 slot = find_slot(current_target());
    if (slot < 0) return;
    i32 key = context_target_index(context, slot);
    i32 call = mock_call_counts[key] & 15;
    mock_call_args[context_call_arg_index(context, slot, call, 0)] = a;
    mock_call_args[context_call_arg_index(context, slot, call, 1)] = b;
    mock_call_args[context_call_arg_index(context, slot, call, 2)] = c;
    mock_call_args[context_call_arg_index(context, slot, call, 3)] = d;
    mock_call_args[context_call_arg_index(context, slot, call, 4)] = e;
    mock_call_args[context_call_arg_index(context, slot, call, 5)] = f;
    mock_call_counts[key] = mock_call_counts[key] + 1;
}

export i32 calls(i32 target) {
    i32 slot = find_slot(target);
    if (slot < 0) return 0;
    i32 total = 0;
    i32 context = 0;
    while (context < 8) {
        if (mock_context_used[context] != 0) {
            total = total + mock_call_counts[context_target_index(context, slot)];
        }
        context = context + 1;
    }
    return total;
}

// Match the supplied prefix of a recorded call. This lets callers verify
// functions with zero through six word arguments without declaring Args.
export i32 called_with(i32 target, rest args) {
    if (args.len > 6) {
        assert_fail("mock.argument_capacity");
        return 0;
    }
    i32 slot = find_slot(target);
    if (slot < 0) return 0;
    i32 context = 0;
    while (context < 8) {
        if (mock_context_used[context] == 0) {
            context = context + 1;
            continue;
        }
        i32 count = mock_call_counts[context_target_index(context, slot)];
        if (count > 16) count = 16;
        i32 call = 0;
        while (call < count) {
        i32 matched = 1;
        if (args.len > 0) {
            i32 expected = args[0];
            i32 actual = mock_call_args[context_call_arg_index(context, slot, call, 0)];
            if (matcher_matches(expected, actual) == 0) matched = 0;
        }
        if (args.len > 1) {
            i32 expected = args[1];
            i32 actual = mock_call_args[context_call_arg_index(context, slot, call, 1)];
            if (matcher_matches(expected, actual) == 0) matched = 0;
        }
        if (args.len > 2) {
            i32 expected = args[2];
            i32 actual = mock_call_args[context_call_arg_index(context, slot, call, 2)];
            if (matcher_matches(expected, actual) == 0) matched = 0;
        }
        if (args.len > 3) {
            i32 expected = args[3];
            i32 actual = mock_call_args[context_call_arg_index(context, slot, call, 3)];
            if (matcher_matches(expected, actual) == 0) matched = 0;
        }
        if (args.len > 4) {
            i32 expected = args[4];
            i32 actual = mock_call_args[context_call_arg_index(context, slot, call, 4)];
            if (matcher_matches(expected, actual) == 0) matched = 0;
        }
        if (args.len > 5) {
            i32 expected = args[5];
            i32 actual = mock_call_args[context_call_arg_index(context, slot, call, 5)];
            if (matcher_matches(expected, actual) == 0) matched = 0;
        }
        if (matched != 0) return 1;
        call = call + 1;
        }
        context = context + 1;
    }
    return 0;
}

export i32 times(i32 target, i32 expected) { return calls(target) == expected; }
export i32 once(i32 target) { return times(target, 1); }
export i32 never(i32 target) { return times(target, 0); }

TargetRule* (TargetMock* self) when(rest args) {
    i32 slot = self->slot;
    i32 rule = mock_rule_counts[slot];
    if (rule >= 8) {
        assert_fail("mock.rule_capacity");
        return (TargetRule*)0;
    }
    if (args.len > 6) {
        assert_fail("mock.argument_capacity");
        return (TargetRule*)0;
    }
    i32 key = rule_index(slot, rule);
    mock_rule_arg_counts[key] = args.len;
    i32 index = 0;
    while (index < args.len) {
        mock_rule_args[rule_arg_index(slot, rule, index)] = args[index];
        index = index + 1;
    }
    mock_rule_return_counts[key] = 0;
    i32 context = 0;
    while (context < 8) {
        mock_rule_cursors[context_rule_index(context, slot, rule)] = 0;
        context = context + 1;
    }
    mock_rule_callbacks[key] = 0;
    mock_rule_counts[slot] = rule + 1;
    mock_rule_handles[key].slot = slot;
    mock_rule_handles[key].rule = rule;
    return &mock_rule_handles[key];
}

TargetRule* (TargetRule* self) ret(i32 value) {
    i32 key = rule_index(self->slot, self->rule);
    // A rule has one action.  A later `.ret(...)` deliberately replaces a
    // previously configured fake while still allowing chained return values.
    mock_rule_callbacks[key] = 0;
    i32 count = mock_rule_return_counts[key];
    if (count >= 8) {
        assert_fail("mock.return_capacity");
        return (TargetRule*)0;
    }
    mock_rule_returns[rule_return_index(self->slot, self->rule, count)] = value;
    mock_rule_return_counts[key] = count + 1;
    return self;
}

TargetRule* (TargetRule* self) then_ret(i32 value) {
    return self.ret(value);
}

// Invoke `fn` for a matching call instead of returning a stored word.  This
// makes pointer/out-parameter effects testable without making production code
// depend on DI. `fn` must have the same signature as the target. This includes
// struct/array returns: the generated entry preserves their hidden r4 result
// buffer. Use `.call(fake)` for those returns; `.ret(...)` stores one word.
TargetRule* (TargetRule* self) call(i32 fn) {
    i32 key = rule_index(self->slot, self->rule);
    mock_rule_return_counts[key] = 0;
    i32 context = 0;
    while (context < 8) {
        mock_rule_cursors[context_rule_index(context, self->slot, self->rule)] = 0;
        context = context + 1;
    }
    mock_rule_callbacks[key] = fn;
    return self;
}

// Called by an entry after enter(target). The first three machine ABI arguments are already in
// r5-r7 plus the first three stack arguments become a..f here. A nonzero return means either
// current_result() or current_callback() is valid; the latter takes precedence.
export i32 dispatch(i32 a, i32 b, i32 c, i32 d, i32 e, i32 f) {
    i32 context = context_slot(1);
    if (context < 0) return 0;
    i32 depth = mock_active_depths[context];
    if (depth <= 0) return 0;
    i32 active = context_active_index(context, depth - 1);
    mock_context_callbacks[active] = 0;
    i32 slot = find_slot(current_target());
    if (slot < 0 || mock_modes[slot] == 0) return 0;
    i32 rule = mock_rule_counts[slot];
    while (rule != 0) {
        rule = rule - 1;
        i32 key = rule_index(slot, rule);
        i32 count = mock_rule_arg_counts[key];
        i32 matched = 1;
        if (count > 0) {
            i32 expected = mock_rule_args[rule_arg_index(slot, rule, 0)];
            if (matcher_matches(expected, a) == 0) matched = 0;
        }
        if (count > 1) {
            i32 expected = mock_rule_args[rule_arg_index(slot, rule, 1)];
            if (matcher_matches(expected, b) == 0) matched = 0;
        }
        if (count > 2) {
            i32 expected = mock_rule_args[rule_arg_index(slot, rule, 2)];
            if (matcher_matches(expected, c) == 0) matched = 0;
        }
        if (count > 3) {
            i32 expected = mock_rule_args[rule_arg_index(slot, rule, 3)];
            if (matcher_matches(expected, d) == 0) matched = 0;
        }
        if (count > 4) {
            i32 expected = mock_rule_args[rule_arg_index(slot, rule, 4)];
            if (matcher_matches(expected, e) == 0) matched = 0;
        }
        if (count > 5) {
            i32 expected = mock_rule_args[rule_arg_index(slot, rule, 5)];
            if (matcher_matches(expected, f) == 0) matched = 0;
        }
        if (matched != 0 && mock_rule_callbacks[key] != 0) {
            mock_context_callbacks[active] = mock_rule_callbacks[key];
            return 1;
        }
        if (matched != 0 && mock_rule_return_counts[key] != 0) {
            i32 cursor_key = context_rule_index(context, slot, rule);
            i32 cursor = mock_rule_cursors[cursor_key];
            i32 returns = mock_rule_return_counts[key];
            if (cursor >= returns) cursor = returns - 1;
            mock_context_results[active] = mock_rule_returns[rule_return_index(slot, rule, cursor)];
            if (mock_rule_cursors[cursor_key] < returns - 1) {
                mock_rule_cursors[cursor_key] = mock_rule_cursors[cursor_key] + 1;
            }
            return 1;
        }
    }
    return 0;
}

// The generated entry invokes the original implementation only for an
// unmatched Spy call. Mock mismatch is an assertion failure.
export i32 should_call_original() {
    i32 slot = find_slot(current_target());
    if (slot < 0) return 0;
    return mock_modes[slot] == 2;
}

// Available only while a `.call(fake)` is running. The entry keeps the
// unredirected target address in the current context, so this is a true call to
// the production implementation rather than a recursive trip through the
// mock entry. The TestKit v1 ABI supports up to six word arguments.
export i32 call_original(rest args) {
    if (args.len > 6) {
        assert_fail("mock.argument_capacity");
        return 0;
    }
    i32 fn = current_target();
    if (fn == 0) {
        assert_fail("mock.call_original.outside_fake");
        return 0;
    }
    if (args.len == 0) return fn();
    if (args.len == 1) return fn(args[0]);
    if (args.len == 2) return fn(args[0], args[1]);
    if (args.len == 3) return fn(args[0], args[1], args[2]);
    if (args.len == 4) return fn(args[0], args[1], args[2], args[3]);
    if (args.len == 5) return fn(args[0], args[1], args[2], args[3], args[4]);
    return fn(args[0], args[1], args[2], args[3], args[4], args[5]);
}

export void unexpected(char* reason) { assert_fail(reason); }
